<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:id="@+id/lesson_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:text="@string/app_name" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lesson_complete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lesson_done"
        style="@style/Action" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/local_play"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/video_local"
        style="@style/Widget.Material3.Button.OutlinedButton" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/local_attach"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/video_attach"
        style="@style/Widget.Material3.Button.OutlinedButton" />
    <TextView
        android:id="@+id/local_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Body"
        android:text="@string/video_missing" />
</LinearLayout>
